# Existing application configuration (keep real values out of source control)
MONGO_URI=
# Optional: override Node's process-wide DNS resolver when local DNS refuses Atlas SRV lookups.
# Leave empty on hosts with working DNS.
MONGO_DNS_SERVERS=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=surmakuulutus.ee,www.surmakuulutus.ee
SECURITY_LOG_SALT=
# Enable only behind Netlify ingress, which overwrites its client-IP header.
# Set this in Netlify Functions environment if NETLIFY=true is not available at runtime.
TRUST_NETLIFY_PROXY=
OPENAI_API_KEY=
AI_GENERATION_SECRET=

# Single administrator; use the exact origin serving /admin. HTTPS required in production.
ADMIN_EMAIL=
BETTER_AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Setup command only: remove after account creation. Never prefix with NEXT_PUBLIC_.
ADMIN_PASSWORD=
